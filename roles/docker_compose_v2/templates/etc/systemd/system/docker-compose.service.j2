{#
  The unit must address the same project as the docker_compose_v2 module task,
  otherwise it starts a second project next to it (a project_name that differs
  from the directory name) or reads a different compose file.
#}
{% set compose = [docker_compose_v2_docker_cli | default('/usr/bin/docker')] %}
{% if docker_compose_v2_cli_context is defined %}
{% set compose = compose + ['--context', docker_compose_v2_cli_context] %}
{% else %}
{% set compose = compose + ['--host', docker_compose_v2_docker_host] %}
{% endif %}
{% set compose = compose + ['compose'] %}
{% if docker_compose_v2_project_name is defined %}
{% set compose = compose + ['--project-name', docker_compose_v2_project_name] %}
{% endif %}
{% set compose = compose + (docker_compose_v2_files | default([]) | map('regex_replace', '^', '--file ') | list) %}
{% if docker_compose_v2_env_file is defined %}
{% set compose = compose + ['--env-file', docker_compose_v2_env_file] %}
{% endif %}
{% set compose = compose + (docker_compose_v2_profiles | default([]) | map('regex_replace', '^', '--profile ') | list) %}
[Unit]
Description={{ docker_compose_v2_project }} service with docker compose
PartOf=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=true
WorkingDirectory={{ docker_compose_v2_directory }}
ExecStart={{ compose | join(' ') }} up -d{{ ' --remove-orphans' if docker_compose_v2_remove_orphans else '' }}
ExecStop={{ compose | join(' ') }} down

[Install]
WantedBy=multi-user.target
