{#- Pod Security Admission configuration -#}
{#- Generated by arillso.container.k3s role -#}
{#- kube-system is exempt: K3s runs privileged system components there -#}
---
apiVersion: apiserver.config.k8s.io/v1
kind: AdmissionConfiguration
plugins:
    - name: PodSecurity
      configuration:
          apiVersion: pod-security.admission.config.k8s.io/v1
          kind: PodSecurityConfiguration
          defaults:
              enforce: "{{ k3s_pod_security_admission_profile }}"
              enforce-version: "latest"
              audit: "{{ k3s_pod_security_admission_profile }}"
              audit-version: "latest"
              warn: "{{ k3s_pod_security_admission_profile }}"
              warn-version: "latest"
          exemptions:
              usernames: []
              runtimeClasses: []
              namespaces:
                  - kube-system
