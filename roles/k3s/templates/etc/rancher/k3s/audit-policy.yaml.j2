{#- Kubernetes audit policy -#}
{#- Generated by arillso.container.k3s role -#}
{#- Without a policy file the apiserver logs nothing, so audit-log-path alone
    would produce an empty file. Noisy read-only and system traffic is dropped
    first, everything else is recorded at k3s_audit_log_level. -#}
---
apiVersion: audit.k8s.io/v1
kind: Policy
omitStages:
    - RequestReceived
rules:
    # Drop high-volume, low-value traffic before the catch-all rule.
    - level: None
      users:
          - system:kube-proxy
      verbs:
          - watch
    - level: None
      userGroups:
          - system:nodes
      verbs:
          - get
          - list
          - watch
    - level: None
      nonResourceURLs:
          - /healthz*
          - /livez*
          - /readyz*
          - /version
          - /metrics
    # Never log the contents of secrets and credentials.
    - level: Metadata
      resources:
          - group: ""
            resources:
                - secrets
                - configmaps
          - group: authentication.k8s.io
            resources:
                - tokenreviews
    - level: "{{ k3s_audit_log_level }}"
